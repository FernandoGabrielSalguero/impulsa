APP_NAME=Impulsa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://impulsagroup.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL en Hostinger (hPanel → Bases de datos)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u104036906_impulsaGroup
DB_USERNAME=u104036906_XXXXX
