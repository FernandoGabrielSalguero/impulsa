# En shared hosting usar file/sync (no requieren tablas cache/sessions/jobs)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@impulsagroup.com
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://impulsagroup.com
SANCTUM_STATEFUL_DOMAINS=impulsagroup.com,www.impulsagroup.com
PUBLIC_API_BASE_URL=https://impulsagroup.com

# Completar en producción
MERCADOPAGO_ACCESS_TOKEN=
