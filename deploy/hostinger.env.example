APP_NAME=Impulsa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://impulsagroup.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# MySQL en Hostinger (hPanel → Bases de datos)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u104036906_impulsaGroup
DB_USERNAME=u104036906_XXXXX
DB_PASSWORD=

# En shared hosting usar file/sync (no requieren tablas cache/sessions/jobs)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@impulsagroup.com
MAIL_FROM_NAME="${APP_NAME}"

HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993
HOSTINGER_IMAP_ENCRYPTION=ssl
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_ENCRYPTION=ssl

FRONTEND_URL=https://impulsagroup.com
# Subcarpeta del panel Angular en Hostinger (ver deploy/root/.htaccess)
FRONTEND_APP_PATH=impulsa_front
SANCTUM_STATEFUL_DOMAINS=impulsagroup.com,www.impulsagroup.com
PUBLIC_API_BASE_URL=https://impulsagroup.com
PUBLIC_MEDIA_URL_MODE=api

# Archivos públicos de integraciones (blog/productos) fuera de public_html
# Solo si PUBLIC_MEDIA_URL_MODE=storage:
PUBLIC_STORAGE_BASE_URL=https://impulsagroup.com/storage
UPLOAD_API_BLOG_LEGACY_PATH=/home/u104036906/domains/impulsagroup.com/storage/API_Blog
UPLOAD_API_PRODUCT_PATH=/home/u104036906/domains/impulsagroup.com/storage/API_Product
UPLOAD_API_PRODUCT_LEGACY_PATH=/home/u104036906/domains/impulsagroup.com/storage/API_Product
UPLOAD_CHATBOT_AVATAR_PATH=/home/u104036906/domains/impulsagroup.com/storage/chatbot-avatars

# Completar en producción
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUBSCRIPTION_PLAN_URL=
MERCADOPAGO_API_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

DEEPSEEK_API_KEY=
AI_USAGE_LOGGING_ENABLED=true
