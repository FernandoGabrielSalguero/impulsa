APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Local: sqlite + database cache OK tras `php artisan migrate`.
# Hostinger/produccion: usar mysql + file (ver deploy/hostinger.env.example).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Registro de uso de IA (tabla ai_usage_logs)
AI_USAGE_LOGGING_ENABLED=true

FRONTEND_URL=http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200
PUBLIC_API_BASE_URL=http://localhost:8000

# Produccion (impulsagroup.com, sin subdominio API):
# APP_URL=https://impulsagroup.com
# FRONTEND_URL=https://impulsagroup.com
# SANCTUM_STATEFUL_DOMAINS=impulsagroup.com,www.impulsagroup.com
# PUBLIC_API_BASE_URL=https://impulsagroup.com

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SUBSCRIPTION_PLAN_URL=
MERCADOPAGO_API_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

IMPULSA_BUSINESS_HOLIDAYS=

# ---------------------------------------------------------------------------
# Rutas de archivos subidos (dejar vacío = default en storage/app/...)
# UPLOAD_*_PATH  → carpeta absoluta en disco (ej. D:/impulsa_uploads/productos)
# UPLOAD_*_PREFIX → prefijo relativo guardado en la base de datos
# ---------------------------------------------------------------------------

# Productos API — main_image, thumbnail, attachment (api_products)
UPLOAD_API_PRODUCT_PATH=
UPLOAD_API_PRODUCT_PREFIX=API_Product

# Blog API — cover_image, attachment (api_blog_posts)
UPLOAD_API_BLOG_PATH=
UPLOAD_API_BLOG_PREFIX=API_Blog

# Avatar del chatbot (panel emprendedor)
UPLOAD_CHATBOT_AVATAR_PATH=
UPLOAD_CHATBOT_AVATAR_PREFIX=chatbot-avatars

# Avatar de usuario / perfil (user_info.avatar_path)
UPLOAD_USER_AVATAR_PATH=
UPLOAD_USER_AVATAR_PREFIX=user-avatars

# Importaciones marketing (marketing_import_batches)
UPLOAD_MARKETING_IMPORT_PATH=
UPLOAD_MARKETING_IMPORT_PREFIX=marketing-imports

# Entregables de proyecto (project_deliverables)
UPLOAD_PROJECT_DELIVERABLE_PATH=
UPLOAD_PROJECT_DELIVERABLE_PREFIX=project-deliverables

# Adjuntos de contratos (project_contracts)
UPLOAD_PROJECT_CONTRACT_PATH=
UPLOAD_PROJECT_CONTRACT_PREFIX=project-contracts
